# ============================================================================
# TTS Service Configuration — Environment Variables
# ============================================================================
# IMPORTANT: This file is an EXAMPLE. Do NOT commit your actual .env file.
# Copy this to .env and fill in real values for your environment.
#
# SECRETS (marked below): Never commit to git. Rotate periodically.
# Non-secrets: Safe to share, documented for clarity.
# ============================================================================

# ----------------------------------------------------------------------------
# SERVICE (non-secret)
# ----------------------------------------------------------------------------
TTS_API_BASE_URL=http://localhost:8080
TTS_SQLITE_PATH=/data/jobs.db
TTS_MAX_TEXT_LENGTH=5000

# ----------------------------------------------------------------------------
# STORAGE (non-secret)
# ----------------------------------------------------------------------------
TTS_STORAGE__PUBLIC_BASE_URL=http://localhost:8080
TTS_STORAGE__AUDIO_PREFIX=audio
TTS_STORAGE__PATH=/data/audio
TTS_STORAGE__CLEANUP_AFTER_DAYS=7

# ----------------------------------------------------------------------------
# QUEUE (non-secret)
# ----------------------------------------------------------------------------
TTS_QUEUE__DEFAULT_FETCH_LIMIT=10

# ----------------------------------------------------------------------------
# SECRETS — do not commit real values
# ----------------------------------------------------------------------------

# API key required by consumers to call /synthesize and /jobs/{id}
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
TTS_API_KEY=

# ElevenLabs API key — from elevenlabs.io dashboard
TTS_BACKENDS__ELEVENLABS__API_KEY=

# Webhook signing secret — shared with consumer for HMAC-SHA256 validation
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
TTS_WEBHOOK__SIGNING_SECRET=

# ----------------------------------------------------------------------------
# BACKENDS (non-secret)
# ----------------------------------------------------------------------------
TTS_BACKENDS__DEFAULT_BACKEND=elevenlabs
TTS_BACKENDS__ELEVENLABS__DEFAULT_VOICE=XB0fDUnXU5powFXDhCwa
TTS_BACKENDS__ELEVENLABS__MODEL_ID=eleven_multilingual_v2

# ----------------------------------------------------------------------------
# WEBHOOK (non-secret)
# ----------------------------------------------------------------------------
TTS_WEBHOOK__ENABLED=true
TTS_WEBHOOK__TIMEOUT_SECONDS=10
TTS_WEBHOOK__RETRY_ATTEMPTS=3

# ----------------------------------------------------------------------------
# LOGGING (non-secret)
# ----------------------------------------------------------------------------
LOG_LEVEL=info

# Optional: override ElevenLabs default voice id
# (If empty, uses config.yaml backends.elevenlabs.default_voice)
ELEVENLABS_DEFAULT_VOICE=
